PORT=3000
# Comma-separated frontend origins. Example for local development:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Use "gemini" or "openai" as the default provider. Frontend can select either provider.
AI_PROVIDER=gemini
GEMINI_API_KEY=put_your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=put_your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
# Firebase Admin service account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON={}
